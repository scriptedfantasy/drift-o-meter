# typescript
*.tsbuildinfo

example

# generated native folders
/ios
/android

# Regenerable analysis output. Screenshots and the progress page stay tracked
# because they are the record the critics judged; these are not.
#   sessions:  npx tsx tools/analysis/run-pipeline.ts <track> <seed> <laps>
#   raw runs:  npx tsx tools/analysis/dump-run.ts <track> <seed> <laps>
artifacts/critic-*/
artifacts/*.json

# An agent's PRIVATE capture directory — the harness's `--out` / `--video-dir` / `--dist` for one
# agent's working run, so concurrent agents do not clear each other's output mid-capture. These
# are regenerable and churn while an agent works. The record stays `artifacts/shots/` and
# `artifacts/video/`: anything an agent wants judged or kept goes there.
artifacts/*/shots/
artifacts/*/video/
artifacts/*/dist/
